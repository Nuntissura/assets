// Shared declarations of the compute module. The composite entry points are instantiated from
// kernel_pixel.wgsl; the blend functions, the mode switch and the adjustment switch are GENERATED by
// kernel.rs from pigment's mode / adjustment facts (one source of truth for the lists); the markers
// below are replaced at pipeline creation.
//
// Layout contract: the v1 entry point `composite` reads bindings 0-3 only; the envelope entry points
// `composite_ext` and `adjust` additionally read 4 (`ext`) and 5 (`lut`). The v1 pipeline layout has
// no binding 4 or 5, so nothing below `ext` may be reachable from `composite`.

struct Params {
    chunk_w: u32,
    chunk_h: u32,
    rx: u32,
    ry: u32,
    rw: u32,
    rh: u32,
    mode: u32,     // pigment StudioBlendMode discriminant
    kind: u32,     // 0 solid fill, 1 region buffer (rw*rh texels), 2 chunk-sized buffer (group result)
    opacity: f32,  // layer opacity * fill opacity
    has_mask: u32, // 1: mask[] holds rw*rh f32 coverages (inversion already applied)
    flags: u32,    // bit 0: REPLACE (clip-run base init), bit 1: CLIP (clipped layer inside a run)
    density: f32,  // mask density; the density step runs only when it is not exactly 1.0
    solid: vec4<f32>,
}

// Plan-extension envelope parameters of one dispatch (ext.rs `ext_bytes`, 288 bytes).
struct Ext {
    head: vec4<u32>,                // x: Blend-If entries, y: adjustment opcode, z: adjustment flags
    bi_ch: vec4<u32>,               // Blend-If channel of entry i: 0 gray, 1 red, 2 green, 3 blue
    bi_src: array<vec4<f32>, 4>,    // [black_start, black_end, white_start, white_end] of "This Layer"
    bi_dst: array<vec4<f32>, 4>,    // the same for "Underlying Layer"
    adj: array<vec4<f32>, 8>,       // adjustment parameters (layout per kind, see ext.rs)
}

@group(0) @binding(0) var<uniform> p: Params;
@group(0) @binding(1) var<storage, read> src: array<vec4<f32>>;
@group(0) @binding(2) var<storage, read_write> dst: array<vec4<f32>>;
@group(0) @binding(3) var<storage, read> mask: array<f32>;
@group(0) @binding(4) var<uniform> ext: Ext;
@group(0) @binding(5) var<storage, read> lut: array<f32>;

// ---- non-separable helpers, W3C Compositing 1 s10.2: the same operations in the same order as
// hsk_studio_pigment::blend_math::{lum, clip_color, set_lum, sat, set_sat} (pigment is the owner;
// parity is tested against it). Functions are prefixed so no WGSL reserved word can collide.

fn hsk_lum(c: vec3<f32>) -> f32 {
    return 0.3 * c.x + 0.59 * c.y + 0.11 * c.z;
}

fn hsk_clip_color(c_in: vec3<f32>) -> vec3<f32> {
    var c = c_in;
    // l, n and x are taken once from the input, as in pigment (the second step reuses them).
    let l = hsk_lum(c_in);
    let n = min(c_in.x, min(c_in.y, c_in.z));
    let x = max(c_in.x, max(c_in.y, c_in.z));
    if (n < 0.0) {
        c = vec3<f32>(l) + (c - vec3<f32>(l)) * l / (l - n);
    }
    if (x > 1.0) {
        c = vec3<f32>(l) + (c - vec3<f32>(l)) * (1.0 - l) / (x - l);
    }
    return c;
}

fn hsk_set_lum(c: vec3<f32>, l: f32) -> vec3<f32> {
    let d = l - hsk_lum(c);
    return hsk_clip_color(c + vec3<f32>(d));
}

fn hsk_sat(c: vec3<f32>) -> f32 {
    return max(c.x, max(c.y, c.z)) - min(c.x, min(c.y, c.z));
}

// Position of each channel in the STABLE ascending order of the three values (equal values keep
// channel order), the order pigment's stable sort gives min / mid / max.
fn hsk_rank3(c: vec3<f32>) -> vec3<u32> {
    return vec3<u32>(
        u32(c.y < c.x) + u32(c.z < c.x),
        u32(c.x <= c.y) + u32(c.z < c.y),
        u32(c.x <= c.z) + u32(c.y <= c.z)
    );
}

fn hsk_sat_channel(v: f32, rank: u32, lo: f32, hi: f32, s: f32) -> f32 {
    if (rank == 2u) {
        return s;
    }
    if (rank == 0u) {
        return 0.0;
    }
    return (v - lo) * s / (hi - lo);
}

fn hsk_set_sat(c: vec3<f32>, s: f32) -> vec3<f32> {
    let lo = min(c.x, min(c.y, c.z));
    let hi = max(c.x, max(c.y, c.z));
    if (!(hi > lo)) {
        return vec3<f32>(0.0);
    }
    let r = hsk_rank3(c);
    return vec3<f32>(
        hsk_sat_channel(c.x, r.x, lo, hi, s),
        hsk_sat_channel(c.y, r.y, lo, hi, s),
        hsk_sat_channel(c.z, r.z, lo, hi, s)
    );
}

//@BLEND_FUNCTIONS@

// Extended-range overflow marker (lane SMB-PIGMENT-EXTENDED-RANGE-2): a texel whose composite is
// not finite is written as alpha 2 (outside every admitted alpha); later composites keep it and
// propagate it out of group results, and the host refuses a read-back holding it with pigment's
// `sample_range_outside_unit`, the error render-cpu returns. The finiteness test reads the
// exponent bits, so it does not depend on float NaN / inf semantics of the shader compiler.
const HSK_OVERFLOW: vec4<f32> = vec4<f32>(0.0, 0.0, 0.0, 2.0);

fn hsk_finite3(v: vec3<f32>) -> bool {
    let e = bitcast<vec3<u32>>(v) & vec3<u32>(0x7f800000u);
    return all(e != vec3<u32>(0x7f800000u));
}

// `Params.flags` bit 2 (extended-range output stage, pigment `composite_over_extended`): linear
// dodge is the unclamped `cb + cs`, screen is Foundry Nuke's float screen (`cb + cs - cb cs` where
// either value is at most 1, else `max`), and the result is not clamped to [0, 1]. Pigment admits
// only the modes `blend_math::extended_defined` in such a plan, so no other formula reaches this
// path.
fn blend(mode: u32, cb: vec3<f32>, cs: vec3<f32>) -> vec3<f32> {
    let extended = (p.flags & 4u) != 0u;
    if (extended && mode == @ADD_MODE@u) {
        return cb + cs;
    }
    if (extended && mode == @SCREEN_MODE@u) {
        let low = (cb <= vec3<f32>(1.0)) | (cs <= vec3<f32>(1.0));
        return select(max(cb, cs), cb + cs - cb * cs, low);
    }
    var raw: vec3<f32> = cs;
    switch (mode) {
//@BLEND_CASES@
        default: {
            raw = cs;
        }
    }
    if (extended) {
        return raw;
    }
    return clamp(raw, vec3<f32>(0.0), vec3<f32>(1.0));
}

//@PIXEL_ENTRIES@

// ---- envelope operators (read bindings 4 and 5; never reachable from `composite`) ----

// coverage_math::range_weight: ramp_up(v; black_start, black_end) * ramp_down(v; white_start,
// white_end). A collapsed pair is a hard cut (the divisions are unreachable then).
fn range_weight(v: f32, r: vec4<f32>) -> f32 {
    var up: f32;
    if (v < r.x) {
        up = 0.0;
    } else if (v >= r.y) {
        up = 1.0;
    } else {
        up = (v - r.x) / (r.y - r.x);
    }
    var down: f32;
    if (v <= r.z) {
        down = 1.0;
    } else if (v > r.w) {
        down = 0.0;
    } else {
        down = (r.w - v) / (r.w - r.z);
    }
    return up * down;
}

// coverage_math::BlendChannel::value: gray is blend_math::lum.
fn blend_if_value(ch: u32, c: vec3<f32>) -> f32 {
    switch (ch) {
        case 1u: {
            return c.x;
        }
        case 2u: {
            return c.y;
        }
        case 3u: {
            return c.z;
        }
        default: {
            return hsk_lum(c);
        }
    }
}

// coverage_math::blend_if_weight: product over the entries, in plan order, of the weight of the
// layer colour under its range and of the backdrop colour under its range.
fn blend_if_weight(source_rgb: vec3<f32>, backdrop_rgb: vec3<f32>) -> f32 {
    var w: f32 = 1.0;
    for (var i = 0u; i < ext.head.x; i = i + 1u) {
        let ch = ext.bi_ch[i];
        w = w * range_weight(blend_if_value(ch, source_rgb), ext.bi_src[i]);
        w = w * range_weight(blend_if_value(ch, backdrop_rgb), ext.bi_dst[i]);
    }
    return w;
}

// ---- adjustment maths: transcriptions of hsk_studio_pigment::adjust_math (the owner); parity is
// tested against it. Parameters are read from `ext.adj` (layout per kind in ext.rs). ----

fn levels_map(x: f32, ib: f32, iw: f32, g: f32, ob: f32, ow: f32) -> f32 {
    var v = clamp((x - ib) / (iw - ib), 0.0, 1.0);
    if (g != 1.0 && v > 0.0) {
        v = pow(v, 1.0 / g);
    }
    return clamp(ob + v * (ow - ob), 0.0, 1.0);
}

fn levels_rec(x: f32, a: vec4<f32>, b: vec4<f32>) -> f32 {
    return levels_map(x, a.x, a.y, a.z, a.w, b.x);
}

// Channel record first, then the composite record (adjust_math::Levels order).
fn levels_apply(rgb: vec3<f32>) -> vec3<f32> {
    let r = levels_rec(rgb.x, ext.adj[2], ext.adj[3]);
    let g = levels_rec(rgb.y, ext.adj[4], ext.adj[5]);
    let b = levels_rec(rgb.z, ext.adj[6], ext.adj[7]);
    return vec3<f32>(
        levels_rec(r, ext.adj[0], ext.adj[1]),
        levels_rec(g, ext.adj[0], ext.adj[1]),
        levels_rec(b, ext.adj[0], ext.adj[1])
    );
}

// Curves are sampled from a host-built table of the prepared natural spline (4096 samples per
// channel: composite, red, green, blue); linear interpolation between samples. A channel without a
// curve is the identity (flag bit clear). The channel curve is applied first, then the composite.
fn lut_eval(base: u32, x: f32) -> f32 {
    let pos = clamp(x, 0.0, 1.0) * 4095.0;
    let i0 = min(u32(floor(pos)), 4094u);
    let f = pos - f32(i0);
    let a = lut[base + i0];
    let b = lut[base + i0 + 1u];
    return a + (b - a) * f;
}

fn curve_ch(ch: u32, x: f32) -> f32 {
    if ((ext.head.z & (1u << ch)) == 0u) {
        return x;
    }
    return lut_eval(ch * 4096u, x);
}

fn curves_apply(rgb: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(
        curve_ch(0u, curve_ch(1u, rgb.x)),
        curve_ch(0u, curve_ch(2u, rgb.y)),
        curve_ch(0u, curve_ch(3u, rgb.z))
    );
}

fn exposure_ch(x: f32) -> f32 {
    let gain = ext.adj[0].x;
    let offset = ext.adj[0].y;
    let gamma = ext.adj[0].z;
    let g = ext.adj[0].w;
    var lin = x;
    if (g != 1.0) {
        lin = select(pow(x, g), 0.0, x <= 0.0);
    }
    var v = clamp(lin * gain + offset, 0.0, 1.0);
    if (gamma != 1.0 && v > 0.0) {
        v = pow(v, 1.0 / gamma);
    }
    if (g != 1.0 && v > 0.0) {
        v = pow(v, 1.0 / g);
    }
    return clamp(v, 0.0, 1.0);
}

fn exposure_apply(rgb: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(exposure_ch(rgb.x), exposure_ch(rgb.y), exposure_ch(rgb.z));
}

fn threshold_apply(rgb: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(select(0.0, 1.0, hsk_lum(rgb) >= ext.adj[0].x));
}

fn posterize_apply(rgb: vec3<f32>) -> vec3<f32> {
    let n = ext.adj[0].x;
    return min(floor(rgb * n * 0.99609375) / (n - 1.0), vec3<f32>(1.0));
}

// Hue / saturation (master and colorize): rgb <-> hsl exactly as adjust_math (which evaluates in
// binary64; the GPU evaluates in binary32).
fn hs_hsl(c: vec3<f32>) -> vec3<f32> {
    let mx = max(c.x, max(c.y, c.z));
    let mn = min(c.x, min(c.y, c.z));
    let l = (mx + mn) / 2.0;
    if (mx == mn) {
        return vec3<f32>(0.0, 0.0, l);
    }
    let d = mx - mn;
    var s: f32;
    if (l <= 0.5) {
        s = d / (mx + mn);
    } else {
        s = d / (2.0 - mx - mn);
    }
    var h: f32;
    if (mx == c.x) {
        h = (c.y - c.z) / d;
    } else if (mx == c.y) {
        h = 2.0 + (c.z - c.x) / d;
    } else {
        h = 4.0 + (c.x - c.y) / d;
    }
    h = h / 6.0;
    if (h < 0.0) {
        h = h + 1.0;
    }
    return vec3<f32>(h, s, l);
}

fn hs_channel(t_in: f32, m1: f32, m2: f32) -> f32 {
    var t = t_in;
    if (t < 0.0) {
        t = t + 1.0;
    }
    if (t > 1.0) {
        t = t - 1.0;
    }
    var v: f32;
    if (t < 1.0 / 6.0) {
        v = m1 + (m2 - m1) * t * 6.0;
    } else if (t < 0.5) {
        v = m2;
    } else if (t < 2.0 / 3.0) {
        v = m1 + (m2 - m1) * (2.0 / 3.0 - t) * 6.0;
    } else {
        v = m1;
    }
    return clamp(v, 0.0, 1.0);
}

fn hs_rgb(hsl: vec3<f32>) -> vec3<f32> {
    let h = hsl.x;
    let s = hsl.y;
    let l = hsl.z;
    if (s == 0.0) {
        return vec3<f32>(l);
    }
    var m2: f32;
    if (l <= 0.5) {
        m2 = l * (1.0 + s);
    } else {
        m2 = l + s - l * s;
    }
    let m1 = 2.0 * l - m2;
    return vec3<f32>(
        hs_channel(h + 1.0 / 3.0, m1, m2),
        hs_channel(h, m1, m2),
        hs_channel(h - 1.0 / 3.0, m1, m2)
    );
}

fn hs_light(x: f32, l: f32) -> f32 {
    var v = x;
    if (l > 0.0) {
        v = x * (1.0 - l) + l;
    } else if (l < 0.0) {
        v = x * (1.0 + l);
    }
    return clamp(v, 0.0, 1.0);
}

fn hue_saturation_apply(rgb: vec3<f32>) -> vec3<f32> {
    let hue = ext.adj[0].x;
    let sat = ext.adj[0].y;
    let light = ext.adj[0].z;
    if (ext.adj[0].w != 0.0) {
        let hsl = hs_hsl(rgb);
        return hs_rgb(vec3<f32>(hue, sat, hs_light(hsl.z, light)));
    }
    let lit = vec3<f32>(hs_light(rgb.x, light), hs_light(rgb.y, light), hs_light(rgb.z, light));
    var hsl = hs_hsl(lit);
    let turned = hsl.x + hue;
    hsl.x = turned - floor(turned);
    if (sat > 0.0) {
        hsl.y = hsl.y / (1.0 - sat + 0.01);
    } else {
        hsl.y = hsl.y * (1.0 + sat);
    }
    hsl.y = clamp(hsl.y, 0.0, 1.0);
    return hs_rgb(hsl);
}

//@ADJUST_FUNCTIONS@

fn adjust_apply(rgb: vec3<f32>) -> vec3<f32> {
    var out: vec3<f32> = rgb;
    switch (ext.head.y) {
//@ADJUST_CASES@
        default: {
            out = rgb;
        }
    }
    return clamp(out, vec3<f32>(0.0), vec3<f32>(1.0));
}

// Adjustment layer over the running backdrop in `dst` (adjust_math::composite_adjustment): colour
// lerp(Cb, B_mode(Cb, f(Cb)), k), alpha unchanged, a transparent texel stays transparent.
// k = opacity * fill (p.opacity) * mask * Blend-If; the Blend-If source colour is the adjusted
// colour f(Cb) (the layer's content), the destination colour is Cb.
@compute @workgroup_size(8, 8, 1)
fn adjust(@builtin(global_invocation_id) gid: vec3<u32>) {
    if (gid.x >= p.rw || gid.y >= p.rh) {
        return;
    }
    let di = (p.ry + gid.y) * p.chunk_w + (p.rx + gid.x);
    let b = dst[di];
    if (b.a <= 0.0) {
        dst[di] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        return;
    }
    var m: f32 = 1.0;
    if (p.has_mask != 0u) {
        m = mask[gid.y * p.rw + gid.x];
        if (p.density != 1.0) {
            m = clamp(1.0 - p.density * (1.0 - m), 0.0, 1.0);
        }
    }
    let adjusted = adjust_apply(b.rgb);
    let k = p.opacity * m * blend_if_weight(adjusted, b.rgb);
    let blended = blend(p.mode, b.rgb, adjusted);
    let rgb = clamp(b.rgb + (blended - b.rgb) * k, vec3<f32>(0.0), vec3<f32>(1.0));
    dst[di] = vec4<f32>(rgb, b.a);
}
