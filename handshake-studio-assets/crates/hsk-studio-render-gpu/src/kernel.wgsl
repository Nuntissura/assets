// One layer composited into a chunk destination: W3C Compositing 1 straight-alpha source-over
// with blend (s5.1, s9.1.4), the same formula as hsk_studio_pigment::blend_math::composite_over.
// Colours are straight RGB in [0,1] (the host refuses anything else), destinations are RGBA f32
// chunk buffers that start transparent. One invocation owns one destination pixel, so the
// in-place read-modify-write is race free. Sources arrive already in the plan's blending space
// (STU-COL-163).
//
// The blend functions and the mode switch are GENERATED by kernel.rs from pigment's mode facts
// (one source of truth for the list); the markers below are replaced at pipeline creation.

struct Params {
    chunk_w: u32,
    chunk_h: u32,
    rx: u32,
    ry: u32,
    rw: u32,
    rh: u32,
    mode: u32,     // pigment StudioBlendMode discriminant
    kind: u32,     // 0 solid fill, 1 region buffer (rw*rh texels), 2 chunk-sized buffer (group result)
    opacity: f32,  // layer opacity * fill opacity
    has_mask: u32, // 1: mask[] holds rw*rh f32 coverages (inversion already applied)
    flags: u32,    // bit 0: REPLACE (clip-run base init), bit 1: CLIP (clipped layer inside a run)
    pad2: u32,
    solid: vec4<f32>,
}

@group(0) @binding(0) var<uniform> p: Params;
@group(0) @binding(1) var<storage, read> src: array<vec4<f32>>;
@group(0) @binding(2) var<storage, read_write> dst: array<vec4<f32>>;
@group(0) @binding(3) var<storage, read> mask: array<f32>;

// ---- non-separable helpers, W3C Compositing 1 s10.2: the same operations in the same order as
// hsk_studio_pigment::blend_math::{lum, clip_color, set_lum, sat, set_sat} (pigment is the owner;
// parity is tested against it). Functions are prefixed so no WGSL reserved word can collide.

fn hsk_lum(c: vec3<f32>) -> f32 {
    return 0.3 * c.x + 0.59 * c.y + 0.11 * c.z;
}

fn hsk_clip_color(c_in: vec3<f32>) -> vec3<f32> {
    var c = c_in;
    // l, n and x are taken once from the input, as in pigment (the second step reuses them).
    let l = hsk_lum(c_in);
    let n = min(c_in.x, min(c_in.y, c_in.z));
    let x = max(c_in.x, max(c_in.y, c_in.z));
    if (n < 0.0) {
        c = vec3<f32>(l) + (c - vec3<f32>(l)) * l / (l - n);
    }
    if (x > 1.0) {
        c = vec3<f32>(l) + (c - vec3<f32>(l)) * (1.0 - l) / (x - l);
    }
    return c;
}

fn hsk_set_lum(c: vec3<f32>, l: f32) -> vec3<f32> {
    let d = l - hsk_lum(c);
    return hsk_clip_color(c + vec3<f32>(d));
}

fn hsk_sat(c: vec3<f32>) -> f32 {
    return max(c.x, max(c.y, c.z)) - min(c.x, min(c.y, c.z));
}

// Position of each channel in the STABLE ascending order of the three values (equal values keep
// channel order), the order pigment's stable sort gives min / mid / max.
fn hsk_rank3(c: vec3<f32>) -> vec3<u32> {
    return vec3<u32>(
        u32(c.y < c.x) + u32(c.z < c.x),
        u32(c.x <= c.y) + u32(c.z < c.y),
        u32(c.x <= c.z) + u32(c.y <= c.z)
    );
}

fn hsk_sat_channel(v: f32, rank: u32, lo: f32, hi: f32, s: f32) -> f32 {
    if (rank == 2u) {
        return s;
    }
    if (rank == 0u) {
        return 0.0;
    }
    return (v - lo) * s / (hi - lo);
}

fn hsk_set_sat(c: vec3<f32>, s: f32) -> vec3<f32> {
    let lo = min(c.x, min(c.y, c.z));
    let hi = max(c.x, max(c.y, c.z));
    if (!(hi > lo)) {
        return vec3<f32>(0.0);
    }
    let r = hsk_rank3(c);
    return vec3<f32>(
        hsk_sat_channel(c.x, r.x, lo, hi, s),
        hsk_sat_channel(c.y, r.y, lo, hi, s),
        hsk_sat_channel(c.z, r.z, lo, hi, s)
    );
}

//@BLEND_FUNCTIONS@

fn blend(mode: u32, cb: vec3<f32>, cs: vec3<f32>) -> vec3<f32> {
    var raw: vec3<f32> = cs;
    switch (mode) {
//@BLEND_CASES@
        default: {
            raw = cs;
        }
    }
    return clamp(raw, vec3<f32>(0.0), vec3<f32>(1.0));
}

@compute @workgroup_size(8, 8, 1)
fn composite(@builtin(global_invocation_id) gid: vec3<u32>) {
    if (gid.x >= p.rw || gid.y >= p.rh) {
        return;
    }
    let di = (p.ry + gid.y) * p.chunk_w + (p.rx + gid.x);
    var s: vec4<f32>;
    if (p.kind == 0u) {
        s = p.solid;
    } else if (p.kind == 1u) {
        s = src[gid.y * p.rw + gid.x];
    } else {
        s = src[di];
    }
    var m: f32 = 1.0;
    if (p.has_mask != 0u) {
        m = mask[gid.y * p.rw + gid.x];
    }
    if ((p.flags & 1u) != 0u) {
        // Base of a clipping run: G := the base content with its own mask applied (no opacity,
        // fill or mode). G was cleared, so a transparent texel is left alone.
        let a_base = s.a * m;
        if (a_base > 0.0) {
            dst[di] = vec4<f32>(s.rgb, a_base);
        }
        return;
    }
    let b = dst[di];
    let a_b = b.a;
    let clip = (p.flags & 2u) != 0u;
    // Clipped layer: its source alpha is multiplied by the base alpha, which is the alpha G holds
    // (G's alpha is held at the base alpha after every clipped composite).
    var s_a = s.a;
    if (clip) {
        s_a = s_a * a_b;
    }
    let opacity = p.opacity * m;
    if (opacity <= 0.0 || s_a <= 0.0) {
        return;
    }
    let a_s = s_a * opacity;
    let blended = blend(p.mode, b.rgb, s.rgb);
    let a_o = a_s + a_b * (1.0 - a_s);
    if (a_o <= 0.0) {
        dst[di] = vec4<f32>(0.0, 0.0, 0.0, 0.0);
        return;
    }
    var rgb: vec3<f32>;
    if (a_b == 0.0) {
        // Nothing underneath: the result colour is the source colour. Taken directly instead of as
        // (a_s * cs) / a_s so it never depends on the division unit's last bit (GPU division is
        // allowed 1-2.5 ulp: 1.0 / 1.0 style quotients can come out one ulp low, which flips the
        // discontinuous colour burn/dodge cases at exact 0.0 and 1.0).
        rgb = s.rgb;
    } else {
        let cs_prime = (1.0 - a_b) * s.rgb + a_b * blended;
        let co = a_s * cs_prime + (1.0 - a_s) * a_b * b.rgb;
        rgb = clamp(co / a_o, vec3<f32>(0.0), vec3<f32>(1.0));
    }
    var out_a = min(a_o, 1.0);
    if (clip) {
        out_a = a_b; // clipped content never extends beyond the base
    }
    dst[di] = vec4<f32>(rgb, out_a);
}
