        {
          "op": "park",
          "args": [
            "a"
          ]
        },
        {
          "op": "bind",
          "args": [
            "editor-b",
            "7"
          ]
        },
        {
          "op": "restore",
          "args": [
            "a",
            null
          ],
          "error": "OccupiedDraft"
        },
        {
          "op": "restore",
          "args": [
            "a",
            "b"
          ]
        },
        {
          "op": "pins",
          "expect": [
            {
              "id": "b",
              "editor": "editor-b",
              "revision": "7"
