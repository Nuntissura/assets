      "steps": [
        {
          "op": "bind",
          "args": [
            "editor-a",
            "1"
          ]
        },
        {
          "op": "fence",
          "store": "old"
        },
        {
          "op": "expand"
        },
        {
          "op": "expanded",
          "expect": true
