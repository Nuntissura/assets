          ]
        },
        {
          "op": "edited",
          "args": [
            "$old",
            "2"
          ],
          "error": "Stale"
        },
        {
          "op": "beginLookup",
          "store": "first"
        },
        {
          "op": "beginLookup",
          "store": "second"
        },
        {
          "op": "edited",
          "args": [
            "$first",
            "2"
          ],
          "error": "Stale"
        },
        {
          "op": "beginComposition",
          "args": [
            "$second"
          ],
          "store": "token"
        },
        {
          "op": "fence",
          "store": "composing"
        },
        {
          "op": "park",
          "args": [
            "blocked"
          ],
          "error": "Stale"
        },
        {
          "op": "edited",
          "args": [
            "$composing",
            "2"
          ]
        },
        {
          "op": "endComposition",
          "args": [
            "$token"
          ]
        },
        {
          "op": "endComposition",
          "args": [
            "$token"
          ],
          "error": "Stale"
        },
        {
          "op": "revoke"
        },
        {
          "op": "pins",
          "expect": []
        },
        {
          "op": "fence",
          "error": "Revoked"
        }
      ]
    },
